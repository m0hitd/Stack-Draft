# ============================================================
# Cloud Architect AI — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your real values.
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# All variables prefixed with VITE_ are exposed to the browser.
# ============================================================


# ------------------------------------------------------------
# [REQUIRED] Firebase Web App Configuration
# ------------------------------------------------------------
# The app no longer talks to Gemini directly from the browser. AI
# generation goes through the `generateProposals` Cloud Function
# (see functions/src/index.ts), which holds the Vertex AI credentials
# server-side. The client only needs Firebase project config to reach
# Auth, App Check, and Functions.
#
# How to get these values:
#   1. Go to https://console.firebase.google.com/
#   2. Select your project (or create one)
#   3. Click the gear icon > Project settings
#   4. Under "Your apps" > Web app, click "Config"
#   5. Copy the values from the firebaseConfig object
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX  # optional, only if Analytics is enabled

# ------------------------------------------------------------
# [REQUIRED] App Check — reCAPTCHA v3 site key
# ------------------------------------------------------------
# Registered in Firebase console > App Check > Web app > reCAPTCHA v3.
# Used client-side to prove requests come from this real web app before
# they reach the generateProposals function.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# ------------------------------------------------------------
# Server-side only (NOT a VITE_ variable — set on the Cloud Function,
# never in the frontend .env)
# ------------------------------------------------------------
# Vertex AI credentials are resolved automatically via Application
# Default Credentials in the Cloud Functions runtime (the function's
# service account needs the "Vertex AI User" IAM role). No API key is
# needed or stored anywhere in this repo.
